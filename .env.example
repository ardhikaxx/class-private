# ==============================================================================
# Environment Configuration — Private Coding Class
# ==============================================================================
# Salin file ini menjadi .env.local untuk penggunaan lokal (development).
# Jangan pernah memasukkan API key, secret, atau credential asli ke dalam git.
# ==============================================================================

# [Wajib di Produksi / Opsional di Development]
# Domain / URL publik aplikasi Anda
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [Pengaturan WhatsApp]
# Nomor WhatsApp pengajar (Format internasional tanpa '+' atau spasi, contoh: 6285933648537)
NEXT_PUBLIC_WHATSAPP_NUMBER=6285933648537

# [Mode Pembayaran / QRIS]
# Pilihan provider:
# - 'static_qris' (Default): Menggunakan QRIS statis lokal dari file public/qris.jpeg
# - 'dynamic': Menggunakan dynamic payment gateway (Midtrans / Xendit / Tripay)
PAYMENT_PROVIDER=static_qris

# [Credential Payment Gateway (Hanya jika PAYMENT_PROVIDER=dynamic)]
# Secret key backend payment gateway (HANYA dibaca di server-side, jangan expose ke NEXT_PUBLIC_*)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
